# Copy this file to ".env" and fill in your own values

# MongoDB connection string
# Local MongoDB:   mongodb://localhost:27017/
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster-url>/
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=visitor_management

# Flask secret key (used to sign session cookies) - change this in production
SECRET_KEY=change-this-to-a-random-secret-key

# Default admin account created automatically the first time the app runs
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_EMAIL=admin@vms.local

FLASK_ENV=development
FLASK_DEBUG=1
