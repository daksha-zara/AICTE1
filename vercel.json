{
  "version": 2,
  "builds": [
    {
      "src": "visitor-management-system/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "visitor-management-system/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/visitor-management-system/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/visitor-management-system/app.py"
    }
  ]
}
